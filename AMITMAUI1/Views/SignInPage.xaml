<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AMITMAUI1.Views.SignInPage"
             
             xmlns:Views="clr-namespace:AMITMAUI1.VeiwModels"
             x:DataType="Views:SignInVeiwModel"
             
             
             Title="SignInPage">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="Purple"/>
            <GradientStop Offset="0.5" Color="#3a7bd5"/>
            <GradientStop Offset="1.0" Color="LightCyan"/>
        </LinearGradientBrush>

    </ContentPage.Background>
    <VerticalStackLayout
   Padding="30"
   Spacing="25"
   VerticalOptions="Center">
        <Border
       Padding="10"
       Stroke="#ccc"
       StrokeShape="RoundRectangle 8"
       StrokeThickness="1">
            <Entry
           Text="{Binding Username}"
           Keyboard="Email"
           FontSize="18"
           Placeholder="Email"
           TextColor="Wheat"
           ReturnType="Go"/>
        </Border>
        <Border
       Padding="10"
       Stroke="#ccc"
       StrokeShape="RoundRectangle 8"
       StrokeThickness="1">
            <Grid
           Padding="10"
           ColumnDefinitions="*,Auto"
           VerticalOptions="Center">
                <Entry
                   Text="{Binding UserPassword}" 
                   BackgroundColor="Transparent"
                   FontSize="18"
                   IsPassword="{Binding EntryAsPassword}"
                   Placeholder="סיסמה"
                   TextColor="Wheat"
                   VerticalOptions="Center"/>
                <Button            
                   Margin="5,0,0,0"
                   Padding="0"
                   BackgroundColor="Transparent"
                   FontSize="24"
                   HorizontalOptions="End"
                   Text="{Binding TogglePasswordButtonText}"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   VerticalOptions="Center"
                   Command="{Binding ShowPasswordCommand}"/>
            </Grid>
        </Border>

        <!-- כפתור כניסה-->
        <Button
           CornerRadius="8"
           FontSize="18"
           HeightRequest="50"
           Text="חיבור"
           TextColor="White"
           Command="{Binding SignInCommand}"/>

        <!-- שגיאה-->
        <Label
       FontSize="45"
       HorizontalTextAlignment="Center"
       IsVisible="{Binding IsMessageLabelVisble}"
       Text="{Binding MessageText}"
       TextColor="{Binding MessageTextColor}"/>

    </VerticalStackLayout>
</ContentPage>